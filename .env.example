# Ambiente
NODE_ENV=development

# Configuração do Supabase
EXPO_PUBLIC_SUPABASE_URL=sua-url-do-supabase
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-anonima

# Configuração de autenticação
EXPO_PUBLIC_USE_PHONE_AUTH=true

# Push Notifications (true para habilitar, false para desabilitar)
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true

# (Opcional) URL base das Supabase Edge Functions.
# Se omitido, o app usa automaticamente: EXPO_PUBLIC_SUPABASE_URL + /functions/v1
# EXPO_PUBLIC_SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1

# URLs de redirecionamento (automático via app.config.js)
# APP_SCHEME=luva-branca